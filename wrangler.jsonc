{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgelab-reliability",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "services": [{ "binding": "ORIGIN", "service": "edgelab-origin" }],
  "durable_objects": {
    "bindings": [{ "name": "LABS", "class_name": "ReliabilityLab" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReliabilityLab"] }],
  "observability": { "enabled": true },
}
