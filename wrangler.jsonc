{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgelab-reliability",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "services": [{ "binding": "ORIGIN", "service": "edgelab-origin" }],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "LABS", "class_name": "ReliabilityLab" },
      { "name": "MONITORS", "class_name": "MonitorStore" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReliabilityLab"] },
    { "tag": "v2", "new_sqlite_classes": ["MonitorStore"] },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "AI_BRIEFS_ENABLED": "false",
    "MONITOR_TARGETS": "[{\"id\":\"catalog\",\"name\":\"Catalog service\",\"url\":\"https://origin.internal/catalog\",\"transport\":\"origin\",\"assertion\":\"catalog-json\"},{\"id\":\"gateway\",\"name\":\"Gateway API\",\"url\":\"https://edgelab-reliability.edgelab-henrywashuhe.workers.dev/api/health\",\"transport\":\"https\",\"assertion\":\"ok-json\"}]",
  },
  "observability": { "enabled": true },
}
